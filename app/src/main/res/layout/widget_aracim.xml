<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F7FAFF">
    <TextView android:id="@+id/widgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aracım Pro" android:textStyle="bold" android:textSize="18sp" android:textColor="#11233F" />
    <TextView android:id="@+id/widgetSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Araç" android:textSize="14sp" android:textColor="#36506D" />
    <TextView android:id="@+id/widgetDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Bakım" android:textSize="12sp" android:textColor="#6E8197" />
</LinearLayout>
